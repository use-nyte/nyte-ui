{
  "name": "@use-nyte/nyte-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "pnpm -r run build && pnpm run storybook:build",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --output-dir .generated/storybook",
    "typecheck": "pnpm --filter @use-nyte/ui-core run build && pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "pnpm exec lint",
    "lint:fix": "pnpm exec lint --fix",
    "format": "pnpm exec format",
    "format:write": "pnpm exec format --write"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.8",
    "@use-nyte/eslint-config": "^2.0.3",
    "@use-nyte/prettier-config": "^2.0.3",
    "solid-js": "^1.9.20",
    "storybook": "^10.6.8",
    "storybook-solidjs-vite": "^10.7.4",
    "typescript": "^6.0.3",
    "vite": "^7.3.8",
    "vite-plugin-solid": "^2.11.17"
  }
}
